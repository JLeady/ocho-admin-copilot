# Copy this file to `.env` in this same folder (server/.env) and fill in real values.
# .env is gitignored — it never gets committed.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Any long random string — used to sign the login session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the backend listens on (the Vite dev server proxies /api here).
PORT=3001

# No admin password to set here anymore — the first time the app runs with
# zero accounts, it shows a one-time "create your account" screen. That
# first account becomes the owner; the owner adds everyone else from inside
# the app (Team panel).

# ---- Forgot-password emails (all optional) ----
# Without these, "Forgot password?" on the login screen tells people to ask
# their team owner instead, and any reset link that does get generated (e.g.
# via the API directly) is only ever logged to this server's own console —
# nothing is silently broken, it just can't email anyone yet.
#
# Any SMTP account works here — a personal Gmail with an App Password
# (requires 2-Step Verification; generate one at myaccount.google.com/apppasswords),
# a transactional service's SMTP credentials (Resend, SendGrid, etc.), or a
# business mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if not set.
EMAIL_FROM=

# Where the emailed reset link should point — the origin people actually
# open the app at. http://localhost:5173 while using `npm run dev`;
# http://localhost:3001 if you're running it via `npm start` instead.
APP_URL=http://localhost:5173
